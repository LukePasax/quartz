.obsidian/.trash/
.obsidian/backups/
.obsidian/updates.json
.obsidian/plugins.json
.obsidian/graph.json
.obsidian/app.json
.obsidian/cache/
.obsidian/sync*
.obsidian/appearance-backup.json
.obsidian/plugins-global.json

# System and temp files
